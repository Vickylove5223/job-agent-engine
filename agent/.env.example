# Browserbase (hosted browsers — https://www.browserbase.com → Settings → API keys)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Google AI Studio key (free) — used by Gemini for scoring/tailoring and by Stagehand.
MODEL_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
GEMINI_RPM=8
STAGEHAND_MODEL=google/gemini-flash-latest

# Firebase Admin: paste the service-account JSON on one line (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT=

# Safety: fill forms but never submit until you set this to false
DRY_RUN=true
MAX_APPLY_PER_RUN=2

# Optional
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Local tests only: path to a resume PDF for src/ai/selftest.ts
RESUME_PDF=
